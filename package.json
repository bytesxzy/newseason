{
  "name": "cell4-arc-local",
  "version": "1.1.0",
  "private": true,
  "description": "Offline CELL4 ARC portfolio plus the local language stack (QueryFrame, reasoning graph, evidence federation, realiser)",
  "scripts": {
    "lm:memory": "node tools/lm-memory.js",
    "build": "node c4-arc/build.js",
    "test": "node tools/dataset-fetch.js && node c4-arc/test.js && node c4-arc/kernel-test.js && node c4-arc/integration-test.js && node c4-arc/generalize-test.js && node c4-gates-test.js && node tools/reason-kernel-test.js && node tools/lm-phrasing-test.js && node tools/lm-comprehend-test.js && node tools/lm-awareness-test.js && node tools/lm-tools-test.js && node tools/lm-deliberate-test.js && node tools/lm-chat-test.js && node tools/dataset-test.js && node tools/lm-crossref-test.js && node tools/arc3-world-test.js",
    "bench": "node c4-arc/bench.js",
    "lm:eval": "node tools/lm-eval.js --out measurements/lm-after.json --label after",
    "lm:baseline": "node tools/lm-eval.js --out measurements/lm-baseline.json --label baseline",
    "lm:paraphrase": "node tools/lm-paraphrase.js",
    "lm:ablate": "node tools/lm-ablate.js",
    "lm:bench": "node tools/lm-bench.js --n 1200",
    "lm:web": "node tools/lm-web-bench.js",
    "lm:robust": "node tools/lm-robustness.js",
    "lm:phrasing": "node tools/lm-phrasing-test.js",
    "lm:comprehend": "node tools/lm-comprehend-test.js",
    "lm:awareness": "node tools/lm-awareness-test.js",
    "lm:heldout3": "node tools/lm-heldout3.js --out measurements/lm-heldout3-after.json",
    "lm:heldout": "node tools/lm-heldout.js --out measurements/lm-heldout-after.json && node tools/lm-heldout2.js --out measurements/lm-heldout2-after-fixes.json",
    "lm:test": "node tools/lm-robustness.js && node tools/lm-eval.js --out measurements/lm-after.json --label after",
    "arc:curriculum": "node tools/arc-curriculum.js --suite v2 --train 600 --eval 300 --seed 11 --steps 4 --ms 250 --write --out measurements/arc-curriculum-v2.json && node c4-arc/build.js",
    "arc3:synth": "node tools/arc3-synth.js --games 30 --out measurements/arc3-synth.json",
    "reason:synth": "node tools/reason-synth.js --n 256 --seed 3 --out measurements/reason-synth.json",
    "arc:curriculum:legacy": "node tools/arc-curriculum.js --train 1500 --eval 800 --seed 11 --steps 4 --out measurements/arc-curriculum.json",
    "arc:macros": "node tools/arc-macros.js --train 240 --val 80 --test 120 --ms 300 --seed 21 --write --out measurements/arc-macros.json && node c4-arc/build.js",
    "arc:generalize": "node c4-arc/generalize-test.js",
    "lm:tools": "node tools/lm-tools-test.js",
    "lm:deliberate": "node tools/lm-deliberate-test.js",
    "lm:chat": "node tools/lm-chat-test.js",
    "lm:chat:heldout": "node tools/lm-chat-eval.js --out measurements/lm-chat-heldout-after.json",
    "arc3:hard": "node tools/arc3-synth.js --suite hard --games 10 --out measurements/arc3-hard.json",
    "arc3:test": "node tools/arc3-world-test.js",
    "arc:ablate": "node tools/arc-ablate.js --n 100 --rep 40 --ms 500 --seed 31 --out measurements/arc-ablation.json",
    "arc:clean": "node c4-arc/bench.js --policy-mode clean --budget 3 --jobs 3 --out results/arc1-clean",
    "arc:nopolicy": "node c4-arc/bench.js --policy-mode none --budget 3 --jobs 3 --out results/arc1-nopolicy",
    "arc:profile": "node tools/arc-profile.js results/arc1-nopolicy --out measurements/arc-profile.json",
    "reason:heldout": "node tools/reason-synth.js --heldout --n 160 --seed 9 --out measurements/reason-heldout.json",
    "dataset:fetch": "node tools/dataset-fetch.js",
    "dataset:test": "node tools/dataset-test.js",
    "lm:crossref": "node tools/lm-crossref-test.js",
    "lm:crossref:heldout": "node tools/lm-chat-eval.js --set tools/crossref-heldout.json --show"
  },
  "engines": {
    "node": ">=18"
  }
}
